apiVersion: v1
kind: Namespace
metadata:
  name: {{ namespace_name }}
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata:
  name: protect-{{ namespace_name }}
spec:
  failurePolicy: Fail
  matchConstraints:
    resourceRules:
      - apiGroups: [""]
        apiVersions: ["v1"]
        operations: ["DELETE"]
        resources: ["namespaces"]
  validations:
    - expression: "oldObject.metadata.name != '{{ namespace_name }}'"
      message: "The {{ namespace_name }} namespace is protected from deletion."
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata:
  name: protect-{{ namespace_name }}
spec:
  policyName: protect-{{ namespace_name }}
  validationActions: [Deny]
